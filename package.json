{
  "name": "@echoessh/sdk",
  "version": "1.2.1",
  "description": "Official SDK for Echoes - Centralized feedback platform for developers",
  "author": "Echoes",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/experiments.min.js",
  "jsdelivr": "./dist/experiments.min.js",
  "bin": {
    "echoes": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./experiments/browser": "./dist/experiments.min.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "echoes",
    "feedback",
    "user-feedback",
    "bug-reports",
    "feature-requests",
    "saas",
    "sdk",
    "ratings",
    "experiments",
    "ab-testing",
    "feature-flags"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echoes-sh/sdk.git"
  },
  "homepage": "https://github.com/echoes-sh/sdk#readme",
  "bugs": {
    "url": "https://github.com/echoes-sh/sdk/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@rrweb/record": "^2.1.7",
    "@rrweb/types": "^2.1.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "vitest": "^3.2.7"
  }
}
